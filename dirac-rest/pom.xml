<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.dirac</groupId>
        <artifactId>dirac-parent</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>dirac-rest</artifactId>
    <name>Dirac :: REST Endpoint</name>
    <description>JAX-RS GET /metrics endpoint (OpenMetrics / Prometheus text format) — optional module activated if Cassini is present</description>

    <dependencies>
        <dependency>
            <groupId>io.vidocq.dirac</groupId>
            <artifactId>dirac-core</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Compile-only (optional at runtime): supplies the VaubanComponentProvider service type
             named in module-info `provides`. Non-transitive; absent under non-Vauban containers. -->
        <dependency>
            <groupId>io.vidocq.vauban</groupId>
            <artifactId>vauban-api</artifactId>
            <version>${vauban.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Cassini adapter codegen (APT): cassini-api supplies the adapter interface that the
             generated $$CassiniAdapter implements. provided = compile-only, non-transitive — the jar
             carries the pre-generated adapter but stays runtime-agnostic (requires static). -->
        <dependency>
            <groupId>io.vidocq.cassini</groupId>
            <artifactId>cassini-api</artifactId>
            <version>${cassini.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

     <build>
         <plugins>
             <!--
                 Java Modules workaround dirac-rest: keep tests on classpath, then
                 compile module-info.java separately in prepare-package phase.
             -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <executions>
                    <execution>
                        <!-- process-resources (just before `compile`), NOT generate-test-sources:
                             removes a stale module-info.class left in target/classes by a prior
                             prepare-package `compile-module-info`, so a non-clean install/deploy
                             (e.g. CI cache) doesn't trip default-compile into module mode. -->
                        <id>remove-stale-module-info-before-compile</id>
                        <phase>process-resources</phase>
                        <goals><goal>clean</goal></goals>
                        <configuration>
                            <excludeDefaultDirectories>true</excludeDefaultDirectories>
                            <filesets>
                                <fileset>
                                    <directory>${project.build.outputDirectory}</directory>
                                    <includes>
                                        <include>module-info.class</include>
                                    </includes>
                                </fileset>
                            </filesets>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
                Vauban codegen runs as an ANNOTATION PROCESSOR on this module's own beans (the Maven
                plugin is reserved for freezing external, non-APT dependency jars). It generates
                _ClientProxy/_Factory, META-INF/vauban-beans.list (so a Vidocq runtime discovers
                MetricsResource via the Vauban container) and _VaubanComponents (in-module
                instantiation + field injection of the package-private @Inject MetricRegistry fields,
                no opens). Inert / Weld-safe in plain CDI containers.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.vidocq.vauban</groupId>
                            <artifactId>vauban-processor</artifactId>
                            <version>${vauban.version}</version>
                        </path>
                        <!-- Cassini codegen (APT): generates MetricsResource$$CassiniAdapter at compile
                             time (zero-reflection dispatch, AOT-friendly) so a Cassini runtime finds the
                             pre-generated adapter — no runtime adapter generation, no opens, no
                             build-time repackaging needed by the consuming app. -->
                        <path>
                            <groupId>io.vidocq.cassini</groupId>
                            <artifactId>cassini-processor</artifactId>
                            <version>${cassini.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <!-- Library module, not a complete deployment: MetricsResource injects
                         MetricRegistry beans produced in dirac-cdi-vauban (cross-module, absent from
                         the APT index); deployment validation runs at the Vidocq runtime assembly. -->
                    <compilerArgs>
                        <arg>-Avauban.validation=false</arg>
                    </compilerArgs>
                </configuration>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <proc>none</proc>
                        </configuration>
                    </execution>
                    <execution>
                        <id>compile-module-info</id>
                        <phase>prepare-package</phase>
                        <goals><goal>compile</goal></goals>
                        <configuration>
                            <proc>none</proc>
                            <compileSourceRoots>
                                <compileSourceRoot>${project.basedir}/src/main/module-info</compileSourceRoot>
                            </compileSourceRoots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
