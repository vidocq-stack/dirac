<?xml version="1.0" encoding="UTF-8"?>
<!--
    In-reactor TCK runner, gated by the `tck` Maven profile of dirac-parent
    (TCK harmonisation — dirac is the pilot brick, mirroring the
    vidocq-runtime-tck-* pattern): a plain `mvn install` neither downloads nor
    runs anything TCK-related.

    History: this module used to be a STANDALONE out-of-reactor POM to work
    around ShrinkWrap Maven Resolver 3.3 (could not parse Model 4.1.0 POMs).
    That constraint disappeared with the Maven 3.9.16 / Model 4.0.0 migration,
    and the MP Metrics api-tck builds its deployments with addClass/addPackage
    only (no ShrinkWrap Maven resolver), so it is safe in-reactor.

    Execution goes through the script (thin wrapper over the reactor):
        ./run-official-tck-mp-metrics-5.1.sh              (smoke test)
        ./run-official-tck-mp-metrics-5.1.sh all          (full suite)
        ./run-official-tck-mp-metrics-5.1.sh -Dtest=Foo   (targeted class)

    Or directly:
        ./mvnw -Ptck -pl dirac-tck test                   (smoke)
        ./mvnw -Ptck,tck-official -pl dirac-tck test      (full suite)

    MicroProfile Metrics 5.1.1 TCK:
        org.eclipse.microprofile.metrics:microprofile-metrics-tck:5.1.1
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.dirac</groupId>
        <artifactId>dirac-parent</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>dirac-tck</artifactId>
    <packaging>jar</packaging>

    <name>Dirac :: TCK Runner</name>
    <description>MicroProfile Metrics 5.1.1 conformance harness — official TestNG/Arquillian TCK</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
    </properties>

    <repositories>
        <repository>
            <id>vidocq-snapshots</id>
            <url>https://repo.vidocq.dev/snapshots</url>
            <releases><enabled>false</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
    </repositories>

     <dependencyManagement>
         <dependencies>
             <!--
                 Align arquillian to 1.10.1.Final to avoid MalformedParameterizedTypeException
                 under JDK 25 (same workaround as heisenberg-tck / cassini-tck).
             -->
            <dependency>
                <groupId>org.jboss.arquillian.container</groupId>
                <artifactId>arquillian-container-spi</artifactId>
                <version>1.10.1.Final</version>
            </dependency>
            <dependency>
                <groupId>org.jboss.arquillian.container</groupId>
                <artifactId>arquillian-container-impl-base</artifactId>
                <version>1.10.1.Final</version>
            </dependency>
            <dependency>
                <groupId>org.jboss.arquillian.core</groupId>
                <artifactId>arquillian-core-impl-base</artifactId>
                <version>1.10.1.Final</version>
            </dependency>
             <!-- Force CDI API 4.1.0 final -->
             <dependency>
                 <groupId>jakarta.enterprise</groupId>
                 <artifactId>jakarta.enterprise.cdi-api</artifactId>
                 <version>4.1.0</version>
             </dependency>
         </dependencies>
     </dependencyManagement>

     <dependencies>
         <!-- Dirac (managed by dirac-parent at ${project.version}) -->
         <dependency>
             <groupId>io.vidocq.dirac</groupId>
             <artifactId>dirac-api</artifactId>
         </dependency>
         <dependency>
             <groupId>io.vidocq.dirac</groupId>
             <artifactId>dirac-core</artifactId>
         </dependency>
         <dependency>
             <groupId>io.vidocq.dirac</groupId>
             <artifactId>dirac-cdi-vauban</artifactId>
         </dependency>

         <!-- MP Metrics API -->
         <dependency>
             <groupId>org.eclipse.microprofile.metrics</groupId>
             <artifactId>microprofile-metrics-api</artifactId>
         </dependency>

         <!-- Vauban CDI container -->
         <dependency>
             <groupId>io.vidocq.vauban</groupId>
             <artifactId>vauban-core</artifactId>
         </dependency>

         <!-- JUnit Jupiter for smoke test -->
         <dependency>
             <groupId>org.junit.jupiter</groupId>
             <artifactId>junit-jupiter</artifactId>
             <version>6.0.3</version>
             <scope>test</scope>
         </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Test harness, never published (same rule as dirac-bench). -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration>
                    <skipPublishing>true</skipPublishing>
                </configuration>
            </plugin>
            <!--
                Classpath-only harness: neutralise the Java Modules wiring
                inherited from dirac-parent. The TCK archives are unnamed-module
                CDI deployments; putting microprofile-metrics-api on the module
                path duplicates the microprofile.metrics.api module carried by
                the dirac-mp-metrics-api repack.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-compile-deps-to-module-path</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration combine.self="override">
                    <release>25</release>
                </configuration>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>25</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.5</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

     <profiles>
         <!--
             Default profile: JUnit smoke test — verifies that Dirac modules
             load correctly and that MicroProfile Metrics 5.1.1 spec is on the classpath.
         -->
         <profile>
             <id>smoke</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <testExcludes>
                                <exclude>io/vidocq/dirac/tck/arquillian/**</exclude>
                            </testExcludes>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <useModulePath>false</useModulePath>
                            <excludes>
                                <exclude>io/vidocq/dirac/tck/arquillian/**</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

         <!--
             Official TCK profile: Arquillian JUnit 4 + custom Dirac container
             (DiracDeployableContainer starting embedded Vauban).
             The MP Metrics 5.1.1 TCK uses @RunWith(Arquillian.class) and JUnit 4.
             Target: 100% PASS.
         -->
         <profile>
             <id>tck-official</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <useModulePath>false</useModulePath>
                            <dependenciesToScan>
                                <dependency>org.eclipse.microprofile.metrics:microprofile-metrics-api-tck</dependency>
                            </dependenciesToScan>
                            <includes>
                                <include>**/*Test.class</include>
                                <include>**/*Tests.class</include>
                                <include>**/*IT.class</include>
                            </includes>
                            <excludes>
                                <exclude>**/DiracTckSmokeTest.class</exclude>
                            </excludes>
                            <trimStackTrace>false</trimStackTrace>
                            <redirectTestOutputToFile>false</redirectTestOutputToFile>
                            <useFile>false</useFile>
                            <forkedProcessExitTimeoutInSeconds>120</forkedProcessExitTimeoutInSeconds>
                            <systemPropertyVariables>
                                <arquillian.launch>dirac</arquillian.launch>
                            </systemPropertyVariables>
                        </configuration>
                        <dependencies>
                            <dependency>
                                <groupId>org.apache.maven.surefire</groupId>
                                <artifactId>surefire-junit4</artifactId>
                                <version>3.5.5</version>
                            </dependency>
                        </dependencies>
                    </plugin>
                </plugins>
            </build>
             <dependencies>
                 <!-- MicroProfile Metrics 5.1.1 TCK — CDI module/annotations -->
                 <dependency>
                     <groupId>org.eclipse.microprofile.metrics</groupId>
                     <artifactId>microprofile-metrics-api-tck</artifactId>
                     <version>${microprofile.metrics.version}</version>
                     <scope>test</scope>
                 </dependency>

                 <!-- Arquillian JUnit 4 runner (TCK uses @RunWith(Arquillian.class)) -->
                 <dependency>
                     <groupId>org.jboss.arquillian.junit</groupId>
                     <artifactId>arquillian-junit-container</artifactId>
                     <version>1.10.1.Final</version>
                     <scope>test</scope>
                 </dependency>

                 <!-- JUnit 4 — annotations @Test, @RunWith used by TCK -->
                 <dependency>
                     <groupId>junit</groupId>
                     <artifactId>junit</artifactId>
                     <version>4.13.2</version>
                     <scope>test</scope>
                 </dependency>

                 <!-- Hamcrest — assertions used in TCK tests -->
                 <dependency>
                     <groupId>org.hamcrest</groupId>
                     <artifactId>hamcrest-all</artifactId>
                     <version>1.3</version>
                     <scope>test</scope>
                 </dependency>

                 <!-- Jakarta CDI API 4.1 -->
                 <dependency>
                     <groupId>jakarta.enterprise</groupId>
                     <artifactId>jakarta.enterprise.cdi-api</artifactId>
                     <version>4.1.0</version>
                     <scope>test</scope>
                 </dependency>
                 <dependency>
                     <groupId>jakarta.interceptor</groupId>
                     <artifactId>jakarta.interceptor-api</artifactId>
                     <version>2.2.0</version>
                     <scope>test</scope>
                 </dependency>
                 <dependency>
                     <groupId>jakarta.annotation</groupId>
                     <artifactId>jakarta.annotation-api</artifactId>
                     <version>3.0.0</version>
                     <scope>test</scope>
                 </dependency>
             </dependencies>
        </profile>
    </profiles>
</project>
