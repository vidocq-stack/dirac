    <scm>
        <url>https://codeberg.org/Vidocq/dirac</url>
        <connection>scm:git:https://codeberg.org/Vidocq/dirac.git</connection>
        <developerConnection>scm:git:git@forge.vidocq.dev:vidocq/dirac.git</developerConnection>
    </scm>

    <properties>
        <!-- MicroProfile Metrics 5.1.1 API -->
        <microprofile.metrics.version>5.1.1</microprofile.metrics.version>

        <!-- Jakarta CDI 4.1 (Jakarta EE 11) -->
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.inject.version>2.0.1</jakarta.inject.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>

        <!-- Jakarta Interceptors 2.2 (Jakarta EE 11) -->
        <jakarta.interceptor.version>2.2.0</jakarta.interceptor.version>

        <!-- Jakarta REST 4.0 (for dirac-rest) -->
        <jakarta.rs.version>4.0.0</jakarta.rs.version>

        <!-- Vidocq upstream implementations -->
        <vauban.version>0.3.0-SNAPSHOT</vauban.version>
        <ravel.version>0.3.0-SNAPSHOT</ravel.version>
        <cassini.version>0.3.0-SNAPSHOT</cassini.version>

        <!-- JMH for dirac-bench -->
        <jmh.version>1.37</jmh.version>
    </properties>

    <!--
        dirac-tck is intentionally OUT OF REACTOR (standalone POM Model 4.0.0)
        to work around ShrinkWrap Maven Resolver 3.3 which cannot parse
        Model 4.1.0 POMs. It will be invoked by run-official-tck-mp-metrics-5.1.sh
        after local installation of the reactor.
    -->
    <modules>
        <module>dirac-mp-metrics-api</module>
        <module>dirac-api</module>
        <module>dirac-processor</module>
        <module>dirac-core</module>
        <module>dirac-cdi-vauban</module>
        <module>dirac-cdi-vauban-module-it</module>
        <module>dirac-rest</module>
        <module>dirac-bench</module>
        <module>dirac-examples</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- MicroProfile Metrics 5.1.1 API -->
            <dependency>
                <groupId>org.eclipse.microprofile.metrics</groupId>
                <artifactId>microprofile-metrics-api</artifactId>
                <version>${microprofile.metrics.version}</version>
            </dependency>

            <!-- Jakarta CDI -->
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>${jakarta.cdi.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.inject</groupId>
                <artifactId>jakarta.inject-api</artifactId>
                <version>${jakarta.inject.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>${jakarta.annotation.version}</version>
            </dependency>

            <!-- Jakarta Interceptors -->
            <dependency>
                <groupId>jakarta.interceptor</groupId>
                <artifactId>jakarta.interceptor-api</artifactId>
                <version>${jakarta.interceptor.version}</version>
            </dependency>

            <!-- Jakarta REST 4.0 (dirac-rest only) -->
            <dependency>
                <groupId>jakarta.ws.rs</groupId>
                <artifactId>jakarta.ws.rs-api</artifactId>
                <version>${jakarta.rs.version}</version>
            </dependency>

            <!-- Vidocq implementations (used in test scope or runtime) -->
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-api</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-core</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-classloader-spi</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-core</artifactId>
                <version>${ravel.version}</version>
            </dependency>

            <!-- JMH -->
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${jmh.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-generator-annprocess</artifactId>
                <version>${jmh.version}</version>
            </dependency>

            <!-- Internal Dirac modules -->
            <dependency>
                <groupId>io.vidocq.dirac</groupId>
                <artifactId>dirac-mp-metrics-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.dirac</groupId>
                <artifactId>dirac-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.dirac</groupId>
                <artifactId>dirac-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.dirac</groupId>
                <artifactId>dirac-cdi-vauban</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <!--
            Java Modules workaround: microprofile-metrics-api:5.1.1 may not have
            Automatic-Module-Name in its MANIFEST.MF (to be verified on install).

            Solution: maven-dependency-plugin copies all compile-scope JARs to
            target/javamodules/ in the initialize phase. The maven-compiler-plugin receives
            the module-path argument pointing to target/javamodules; javac then derives
            the module name from the file name.
        -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>25</release>
                    <compilerArgs>
                        <arg>--module-path</arg>
                        <arg>${project.build.directory}/javamodules</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>jlink-smoke</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>run-jlink-smoke-ci</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${maven.multiModuleProjectDirectory}/run-jlink-smoke-ci.sh</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
