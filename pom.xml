<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         >
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq</groupId>
        <artifactId>vidocq-parent</artifactId>
        <version>0.1.1-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>io.vidocq.dirac</groupId>
    <artifactId>dirac-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Dirac</name>
    <description>Implémentation MicroProfile Metrics 5.1.1 — zéro librairie tierce, virtual threads, JPMS strict, CDI via Vauban, endpoint REST via Cassini</description>
    <url>https://codeberg.org/Vidocq/dirac</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <scm>
        <url>https://codeberg.org/Vidocq/dirac</url>
        <connection>scm:git:https://codeberg.org/Vidocq/dirac.git</connection>
        <developerConnection>scm:git:git@forge.vidocq.dev:vidocq/dirac.git</developerConnection>
    </scm>

    <properties>
        <!-- MicroProfile Metrics 5.1.1 API -->
        <microprofile.metrics.version>5.1.1</microprofile.metrics.version>

        <!-- Jakarta CDI 4.1 (Jakarta EE 11) -->
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.inject.version>2.0.1</jakarta.inject.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>

        <!-- Jakarta Interceptors 2.2 (Jakarta EE 11) -->
        <jakarta.interceptor.version>2.2.0</jakarta.interceptor.version>

        <!-- Jakarta REST 4.0 (pour dirac-rest) -->
        <jakarta.rs.version>4.0.0</jakarta.rs.version>

        <!-- Implémentations Vidocq upstream -->
        <vauban.version>0.1.0-SNAPSHOT</vauban.version>
        <ravel.version>0.1.0-SNAPSHOT</ravel.version>
        <cassini.version>0.1.0-SNAPSHOT</cassini.version>

        <!-- JMH pour dirac-bench -->
        <jmh.version>1.37</jmh.version>
    </properties>

    <!--
        dirac-tck est volontairement HORS reactor (POM Model 4.0.0 standalone)
        pour contourner ShrinkWrap Maven Resolver 3.3 qui ne sait pas parser les POMs
        Model 4.1.0. Il sera invoqué par run-official-tck-mp-metrics-5.1.sh
        après installation locale du reactor.
    -->
    <modules>
        <module>dirac-mp-metrics-api</module>
        <module>dirac-api</module>
        <module>dirac-core</module>
        <module>dirac-cdi-vauban</module>
        <module>dirac-rest</module>
        <module>dirac-bench</module>
        <module>dirac-examples</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- MicroProfile Metrics 5.1.1 API -->
            <dependency>
                <groupId>org.eclipse.microprofile.metrics</groupId>
                <artifactId>microprofile-metrics-api</artifactId>
                <version>${microprofile.metrics.version}</version>
            </dependency>

            <!-- Jakarta CDI -->
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>${jakarta.cdi.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.inject</groupId>
                <artifactId>jakarta.inject-api</artifactId>
                <version>${jakarta.inject.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>${jakarta.annotation.version}</version>
            </dependency>

            <!-- Jakarta Interceptors -->
            <dependency>
                <groupId>jakarta.interceptor</groupId>
                <artifactId>jakarta.interceptor-api</artifactId>
                <version>${jakarta.interceptor.version}</version>
            </dependency>

            <!-- Jakarta REST 4.0 (dirac-rest uniquement) -->
            <dependency>
                <groupId>jakarta.ws.rs</groupId>
                <artifactId>jakarta.ws.rs-api</artifactId>
                <version>${jakarta.rs.version}</version>
            </dependency>

            <!-- Implémentations Vidocq (utilisées en test scope ou runtime) -->
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-core</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-classloader-spi</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-core</artifactId>
                <version>${ravel.version}</version>
            </dependency>

            <!-- JMH -->
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${jmh.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-generator-annprocess</artifactId>
                <version>${jmh.version}</version>
            </dependency>

            <!-- Modules internes Dirac -->
            <dependency>
                <groupId>io.vidocq.dirac</groupId>
                <artifactId>dirac-mp-metrics-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.dirac</groupId>
                <artifactId>dirac-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.dirac</groupId>
                <artifactId>dirac-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.dirac</groupId>
                <artifactId>dirac-cdi-vauban</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <!--
            JPMS workaround : microprofile-metrics-api:5.1.1 peut ne pas avoir
            d'Automatic-Module-Name dans son MANIFEST.MF (à vérifier à l'install).

            Solution : maven-dependency-plugin copie tous les JARs compile-scope dans
            target/javamodules/ en phase initialize. Le maven-compiler-plugin reçoit
            l'argument module-path pointant vers target/javamodules ; javac dérive alors
            le nom du module depuis le nom de fichier.
        -->
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>copy-compile-deps-to-module-path</id>
                        <phase>initialize</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/javamodules</outputDirectory>
                            <includeScope>compile</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>25</release>
                    <compilerArgs>
                        <arg>--module-path</arg>
                        <arg>${project.build.directory}/javamodules</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>jlink-smoke</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>run-jlink-smoke-ci</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${maven.multiModuleProjectDirectory}/run-jlink-smoke-ci.sh</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
