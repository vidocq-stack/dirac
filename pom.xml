<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq</groupId>
        <artifactId>vidocq-parent</artifactId>
        <version>0.4.0-RC1</version>
        <relativePath />
    </parent>

    <groupId>io.vidocq.dirac</groupId>
    <artifactId>dirac-parent</artifactId>
    <version>0.4.0-RC1</version>
    <packaging>pom</packaging>

    <name>Dirac</name>
    <description>MicroProfile Metrics 5.1.1 implementation — zero third-party libraries, virtual threads, strict Java Modules, CDI via Vauban, REST endpoint via Cassini</description>
    <url>https://codefloe.com/Vidocq/dirac</url>

    
    <licenses>
        <license>
            <name>EPL-2.0</name>
            <url>https://www.eclipse.org/legal/epl-2.0/</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>EUPL-1.2</name>
            <url>https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>GPL-2.0-or-later</name>
            <url>https://www.gnu.org/licenses/old-licenses/gpl-2.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://codefloe.com/Vidocq/dirac</url>
        <connection>scm:git:https://codefloe.com/Vidocq/dirac.git</connection>
        <developerConnection>scm:git:git@forge.vidocq.dev:vidocq/dirac.git</developerConnection>
    </scm>

    <properties>
        
        <microprofile.metrics.version>5.1.1</microprofile.metrics.version>

        
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.inject.version>2.0.1</jakarta.inject.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>

        
        <jakarta.interceptor.version>2.2.0</jakarta.interceptor.version>

        
        <jakarta.rs.version>4.0.0</jakarta.rs.version>

        
        <vauban.version>0.4.0-RC1</vauban.version>
        <ravel.version>0.4.0-RC1</ravel.version>
        <cassini.version>0.4.0-RC1</cassini.version>

        
        <jmh.version>1.37</jmh.version>

        
        <ci.tck.command>mvn -B -ntp -P tck,tck-official -pl dirac-tck test</ci.tck.command>

        
        <sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/dirac-coverage/target/site/jacoco-aggregate/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <sonar.coverage.exclusions>**/dirac-examples/**</sonar.coverage.exclusions>
        <sonar.issue.ignore.multicriteria>examples</sonar.issue.ignore.multicriteria>
        <sonar.issue.ignore.multicriteria.examples.ruleKey>java:S106</sonar.issue.ignore.multicriteria.examples.ruleKey>
        <sonar.issue.ignore.multicriteria.examples.resourceKey>**/dirac-examples/**/src/main/java/**</sonar.issue.ignore.multicriteria.examples.resourceKey>
    </properties>

    
    <modules>
        <module>dirac-mp-metrics-api</module>
        <module>dirac-api</module>
        <module>dirac-processor</module>
        <module>dirac-core</module>
        <module>dirac-cdi-vauban</module>
        <module>dirac-cdi-vauban-module-it</module>
        <module>dirac-rest</module>
        <module>dirac-it-other-containers</module>
        <module>dirac-bench</module>
        <module>dirac-examples</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            
            <dependency>
                <groupId>org.eclipse.microprofile.metrics</groupId>
                <artifactId>microprofile-metrics-api</artifactId>
                <version>${microprofile.metrics.version}</version>
            </dependency>

            
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>${jakarta.cdi.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.inject</groupId>
                <artifactId>jakarta.inject-api</artifactId>
                <version>${jakarta.inject.version}</version>
            </dependency>
            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>${jakarta.annotation.version}</version>
            </dependency>

            
            <dependency>
                <groupId>jakarta.interceptor</groupId>
                <artifactId>jakarta.interceptor-api</artifactId>
                <version>${jakarta.interceptor.version}</version>
            </dependency>

            
            <dependency>
                <groupId>jakarta.ws.rs</groupId>
                <artifactId>jakarta.ws.rs-api</artifactId>
                <version>${jakarta.rs.version}</version>
            </dependency>

            
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-api</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-core</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.vauban</groupId>
                <artifactId>vauban-classloader-spi</artifactId>
                <version>${vauban.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.ravel</groupId>
                <artifactId>ravel-core</artifactId>
                <version>${ravel.version}</version>
            </dependency>

            
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${jmh.version}</version>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-generator-annprocess</artifactId>
                <version>${jmh.version}</version>
            </dependency>

            
            <dependency>
                <groupId>io.vidocq.dirac</groupId>
                <artifactId>dirac-mp-metrics-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.dirac</groupId>
                <artifactId>dirac-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.dirac</groupId>
                <artifactId>dirac-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.dirac</groupId>
                <artifactId>dirac-cdi-vauban</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>


    <profiles>
        
        <profile>
            <id>tck</id>
            <modules>
                <module>dirac-tck</module>
            </modules>
        </profile>
        <profile>
            <id>jlink-smoke</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <inherited>false</inherited>
                        <executions>
                            <execution>
                                <id>run-jlink-smoke-ci</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <workingDirectory>${maven.multiModuleProjectDirectory}</workingDirectory>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${maven.multiModuleProjectDirectory}/run-jlink-smoke-ci.sh</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        
        <profile>
            <id>quality</id>
            <modules>
                <module>dirac-coverage</module>
            </modules>
        </profile>
    </profiles>
</project>